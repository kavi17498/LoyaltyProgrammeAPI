# Environment
NODE_ENV=production

# Domain Configuration
# Use ":80" if accessing via VPS IP without a domain:
DOMAIN=:80
# Or use your actual domain (Caddy will auto-enable HTTPS with Let's Encrypt):
# DOMAIN=api.yourdomain.com

# PostgreSQL Credentials (Change these to strong passwords in production!)
POSTGRES_USER=loyalty_admin
POSTGRES_PASSWORD=replace_with_a_very_strong_password_123!
POSTGRES_DB=loyalty_production_db

# JWT Authentication (Use a long random string, at least 32-64 chars)
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_EXPIRES_IN=1d
